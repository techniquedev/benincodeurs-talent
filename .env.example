# Talent Board Bénin Codeurs : copier en .env pour le développement local.
# Ne jamais commiter de vraie valeur secrète : en production, tout se saisit dans Render.

APP_NAME="Talent Board"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Porto-Novo

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données ---------------------------------------------------------------------
# Local : SQLite (fichier database/database.sqlite).
DB_CONNECTION=sqlite
# Production (Render) : DB_CONNECTION=pgsql et DB_URL=postgresql://utilisateur:motdepasse@hote:5432/base
# DB_URL=

# --- Sessions, cache, files d'attente ----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true   # en production (HTTPS)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Fichiers des membres (photos, visuels de projets) ----------------------------------
# Avec CLOUDINARY_URL : disque Cloudinary. Sans : repli sur storage/app/public (local seulement,
# lancer « php artisan storage:link »).
# Format : cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=talent

# --- E-mails -----------------------------------------------------------------------------
# MAIL_MAILER : log (local, e-mails écrits dans storage/logs/laravel.log), smtp, brevo ou resend.
# Sur Render, préférer brevo ou resend (API HTTP sur le port 443) : le SMTP peut y être bloqué.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="talent@example.com"
MAIL_FROM_NAME="Bénin Codeurs"

# Si MAIL_MAILER=brevo
BREVO_API_KEY=

# Si MAIL_MAILER=resend
RESEND_API_KEY=

# Si MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# --- Vérification VIP à l'inscription ---------------------------------------------------
# URL complète de l'API du site principal (POST), ex. https://benincodeurs.com/api/talent/vip-check
# Le jeton doit être identique à TALENT_API_TOKEN sur le site principal (envoyé en « Authorization: Bearer »).
TALENT_VIP_API_URL=
TALENT_VIP_API_TOKEN=

# --- Premier administrateur --------------------------------------------------------------
# Créé par « php artisan talent:create-admin » (lancé au démarrage du conteneur) s'il n'existe pas.
# Mot de passe : 12 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME="Bénin Codeurs"

VITE_APP_NAME="${APP_NAME}"
